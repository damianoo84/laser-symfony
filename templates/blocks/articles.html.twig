{% set articles = layout.extras|filter(article => article.section == section) %}
{% if articles %}<div class="container{% if section == 'cennik' %} narrow{% endif %} archive-content">
{% for article in articles %}
<div class="faq content-articles"><details id="{{ article.anchor }}">
  <summary>{{ article.title }}</summary>
  <div class="prose">{{ article.body|content_html }}</div>
  {% include 'blocks/article-media.html.twig' with {mediaItems:article.media} %}
</details></div>
{% endfor %}</div>{% endif %}

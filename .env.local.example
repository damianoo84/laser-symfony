APP_ENV=dev
APP_DEBUG=1
# Generate random secret and password hash before first use.
APP_SECRET=replace-with-random-64-hex-characters
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/laser_symfony?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=replace-with-password-hash

# SMTP credentials belong here, never in the admin panel or public files.
# Percent-encode USER/PASSWORD when they contain @, :, /, #, %, etc.
# Prefer implicit TLS (port 465); use the settings supplied by your mail provider.
MAILER_ENABLED=0
MAILER_DSN='smtps://USER:PASSWORD@smtp.example.com:465'
MAILER_FROM='formularz@example.com'

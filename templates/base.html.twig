<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ s['site.title'] }}{% endblock %}</title>
<meta name="description" content="{{ s['site.description'] }}">
<script type="application/ld+json">{{ {'@context':'https://schema.org','@type':'LocalBusiness','name':s['contact.company'],'address':s['contact.address'],'telephone':s['contact.phone'],'email':s['contact.email'],'areaServed':s['contact.area']}|json_encode(15)|raw }}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
<link rel="stylesheet" href="{{ asset('css/motion.css') }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23EA580C'/><text x='50' y='68' font-size='58' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>L</text></svg>">
<script src="{{ asset('js/main.js') }}" defer></script>
<script src="{{ asset('js/motion.js') }}" defer></script>
</head>
<body data-motion="{{ s['motion.mode'] }}">
<a class="skip-link" href="#start">Przejdź do treści</a>
<div id="progress" aria-hidden="true"></div>
<div class="topbar"><div class="container topbar-in">
  <span>📞 <a href="{{ s['contact.phoneHref']|safe_link }}"><strong>{{ s['contact.phone'] }}</strong></a><span class="sep">•</span><a class="hide-m" href="mailto:{{ s['contact.email'] }}">{{ s['contact.email'] }}</a></span>
  <span class="hide-m">{{ s['site.topbar'] }}</span>
</div></div>
<header class="site" id="siteHeader"><div class="container nav">
  <a class="brand" href="#start" aria-label="{{ s['site.name'] }} — strona główna">
    {% if s['site.logo'] %}<img class="brand-logo" src="{{ asset(s['site.logo']|image_path) }}" alt="{{ s['site.name'] }}">{% else %}<span class="logo" aria-hidden="true">{{ s['site.logoText'] }}</span>{% endif %}
    <span class="brand-t">{{ s['site.name'] }}<small>{{ s['site.tagline'] }}</small></span>
  </a>
  <nav class="links" id="navLinks" aria-label="Nawigacja główna">
    {% for link in b['navLink']|default([]) %}<a href="{{ link.get('href')|safe_link }}" data-nav>{{ link.get('label') }}</a>{% endfor %}
    <a class="btn btn-primary btn-sm" href="{{ s['contact.phoneHref']|safe_link }}">📞 {{ s['ui.call'] }}</a>
  </nav>
  <button class="burger" id="burger" aria-label="Otwórz menu" aria-controls="navLinks" aria-expanded="false">☰</button>
</div></header>
<main id="start" tabindex="-1"><h1 class="sr-only">{{ s['site.heading'] }}</h1>{% block body %}{% endblock %}</main>
<footer id="footer"><div class="container">
  <div class="foot-grid">
    <div><b style="color:#fff">{{ s['footer.title'] }}</b><div class="mini">{{ s['footerTagline']|content_html }}</div>{% include 'blocks/socials.html.twig' %}</div>
    <div><h4>{{ s['ui.footerLinks'] }}</h4><ul>{% for link in b['footerLink']|default([]) %}<li><a href="{{ link.get('href')|safe_link }}">{{ link.get('label') }}</a></li>{% endfor %}</ul></div>
    <div><h4>{{ s['ui.contact'] }}</h4><p class="mini"><strong>{{ s['contact.company'] }}</strong><br>{{ s['contact.address'] }}<br>NIP: {{ s['contact.nip'] }}<br><a href="{{ s['contact.phoneHref']|safe_link }}">{{ s['contact.phone'] }}</a><br><a href="mailto:{{ s['contact.email'] }}">{{ s['contact.email'] }}</a></p></div>
  </div>
  <div class="foot" style="margin-top:1.2rem;border-top:1px solid #1e293b;padding-top:1rem"><span>© {{ 'now'|date('Y') }} {{ s['footer.copyright'] }}</span><span><a href="#start">{{ s['ui.backTop'] }}</a> • <a href="{{ path('admin_login') }}">Panel admina</a></span></div>
</div></footer>
<button id="toTop" aria-label="Do góry">↑</button>
<div class="mobile-cta"><a class="call" href="{{ s['contact.phoneHref']|safe_link }}">📞 {{ s['ui.call'] }}</a><a class="quote" href="#kontakt">{{ s['ui.quote'] }}</a></div>
<dialog class="lightbox" id="lightbox" aria-label="Podgląd zdjęcia"><button type="button" aria-label="Zamknij podgląd">✕</button><img id="lbImg" alt=""></dialog>
</body>
</html>

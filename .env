# Symfony app — LAZER
APP_ENV=dev
APP_SECRET=change-in-env-local
DATABASE_URL="sqlite:///%kernel.project_dir%/var/app.db"

# Hasło przechowujemy wyłącznie jako hash w .env.local.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=disabled

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
# Enable only after configuring a real SMTP server and an authorized sender.
MAILER_ENABLED=0
MAILER_FROM=
###< symfony/mailer ###

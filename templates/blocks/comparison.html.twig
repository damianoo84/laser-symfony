{% set position = position|default(50) %}
<div class="ba" role="slider" aria-label="Porównanie przed i po czyszczeniu" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ position }}" tabindex="0">
  {% include 'blocks/image.html.twig' with {imagePath:after,alt:s['ui.after'],sizes:'(max-width: 920px) 92vw, 580px'} only %}
  {# Keep the existing overlay class for CSS/JS compatibility; the left side is PRZED. #}
  <div class="after" style="clip-path:inset(0 {{ 100 - position }}% 0 0)">{% include 'blocks/image.html.twig' with {imagePath:before,alt:s['ui.before'],sizes:'(max-width: 920px) 92vw, 580px'} only %}</div>
  <div class="handle" style="left:{{ position }}%"><span>↔</span></div>
  <span class="ba-tag left">{{ s['ui.before'] }}</span><span class="ba-tag right">{{ s['ui.after'] }}</span>
</div>

{% extends 'admin/base.html.twig' %}
{% block body %}
<section class="card login-card">
  <div class="eyebrow">Witaj w panelu</div>
  <h1>Zaloguj się</h1>
  <p class="sub">Zarządzaj tekstami, zdjęciami i zapytaniami klientów.</p>
  {% if app.request.query.get('changed') %}<div class="flash" role="status">Hasło zmienione. Zaloguj się nowym hasłem.</div>{% endif %}
  {% if error %}<div class="error" role="alert">{{ error }}</div>{% endif %}
  <form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('login') }}">
    <label for="f-user">Login</label>
    <input type="text" id="f-user" name="user" autocomplete="username" required autofocus value="{{ app.request.request.get('user', '') }}">
    <label for="f-pass">Hasło</label>
    <input type="password" id="f-pass" name="pass" autocomplete="current-password" required>
    <button class="btn full" type="submit">Zaloguj się →</button>
  </form>
  <p class="help">Sesja wygasa po godzinie bezczynności.</p>
</section>
{% endblock %}
